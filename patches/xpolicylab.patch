+        image = Image.fromarray(np.transpose(frame, (1, 2, 0)))
+        image = image.resize((width, height), Image.BILINEAR)
+        canvas[y0 : y0 + height, x0 : x0 + width] = np.asarray(image)
+    return np.transpose(canvas, (2, 0, 1))
