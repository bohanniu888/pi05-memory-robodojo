+    def _append_history_observation(self, obs: dict, env_idx: Any) -> None:
+        """每次 update_obs（每执行一个动作步）调用一次；按 history_action_interval 抽帧（DM0.5 口径）。"""
+        sequence = self._history_sequence_by_env.get(env_idx, 0) + 1
