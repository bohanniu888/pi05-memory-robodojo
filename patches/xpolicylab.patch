+    def _generate_caption(self, frame: np.ndarray) -> str:
+        from PIL import Image
+        import torch
+
+        processor, model = self._get_captioner()
+        image = Image.fromarray(np.transpose(frame, (1, 2, 0)))
+        messages = [
+            {
+                "role": "user",
+                "content": [
+                    {"type": "image", "image": image},
+                    {"type": "text", "text": self.history_caption_prompt},
+                ],
+            }
+        ]
+        text = processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
+        inputs = processor(text=[text], images=[image], return_tensors="pt").to(self.history_captioner_device)
+        with torch.inference_mode():
+            output_ids = model.generate(**inputs, max_new_tokens=self.history_text_max_new_tokens, do_sample=False)
+        generated = output_ids[:, inputs["input_ids"].shape[1] :]
+        caption = processor.batch_decode(generated, skip_special_tokens=True)[0]
+        caption = " ".join(caption.split())
