diff --git a/.dockerignore b/.dockerignore
index 51ae733..9c80a8d 100644
--- a/.dockerignore
+++ b/.dockerignore
@@ -20,6 +20,13 @@ smoke_results/
 docker/smoke_logs/
 data/
 
+# ── Downloaded assets cache (~39 GB) ─────────────────────────────────
+# RoboDojo/.cache holds the HuggingFace repo clone; its Assets/ subtree is the
+# 39 GB sparse payload. Assets/ below already covers it through docker's
+# level-insensitive matching, but the rule is stated explicitly so the build
+# context cannot silently balloon if that ever changes.
+.cache/
+
 # ── Assets are mounted at runtime, never baked into the image ─────────
 Assets/
 
